<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_knr_capacity_tree" model="ir.ui.view"><field name="name">knr.capacity.tree</field><field name="model">knr.capacity</field><field name="arch" type="xml">
  <tree><field name="order_id"/><field name="department"/><field name="decision" widget="badge"/><field name="reason"/><field name="confirmed_by"/><field name="confirmed_at"/></tree></field></record>
 <record id="view_knr_capacity_form" model="ir.ui.view"><field name="name">knr.capacity.form</field><field name="model">knr.capacity</field><field name="arch" type="xml">
  <form><header><button name="action_confirm_yes" type="object" string="Sanggup" class="btn-primary" invisible="decision != 'pending'"/><button name="action_confirm_no" type="object" string="Tidak Sanggup" invisible="decision != 'pending'"/><field name="decision" widget="statusbar" statusbar_visible="pending,yes,no"/></header><sheet><group><field name="order_id"/><field name="department"/><field name="reason"/><field name="confirmed_by"/><field name="confirmed_at"/></group></sheet></form></field></record>
 <record id="action_knr_capacity" model="ir.actions.act_window"><field name="name">Konfirmasi Kapasitas</field><field name="res_model">knr.capacity</field><field name="view_mode">tree,form</field></record>
 <record id="view_knr_production_report_form" model="ir.ui.view"><field name="name">knr.production.report.form</field><field name="model">knr.production.report</field><field name="arch" type="xml">
  <form><sheet><group><field name="service_date"/><field name="department"/></group><group string="Pesanan yang Perlu Disiapkan"><field name="order_ids" readonly="1"><tree><field name="name"/><field name="client_id"/><field name="service_datetime"/><field name="special_notes"/><field name="state"/></tree></field><field name="line_ids" readonly="1"><tree><field name="order_id"/><field name="product_id"/><field name="quantity"/><field name="department"/><field name="subtotal"/></tree></field></group></sheet></form></field></record>
 <record id="action_knr_production_report" model="ir.actions.act_window"><field name="name">Kebutuhan Produksi per Tanggal</field><field name="res_model">knr.production.report</field><field name="view_mode">tree,form</field></record>
 <record id="view_knr_shipping_tree" model="ir.ui.view"><field name="name">knr.shipping.config.tree</field><field name="model">knr.shipping.config</field><field name="arch" type="xml">
  <tree><field name="name"/><field name="rate_per_km"/><field name="free_distance_km"/><field name="active"/></tree></field></record>
 <record id="view_knr_shipping_form" model="ir.ui.view"><field name="name">knr.shipping.config.form</field><field name="model">knr.shipping.config</field><field name="arch" type="xml">
  <form><sheet><group><field name="name"/><field name="rate_per_km"/><field name="free_distance_km"/><field name="active"/></group></sheet></form></field></record>
 <record id="action_knr_shipping" model="ir.actions.act_window"><field name="name">Ketentuan Ongkos Kirim</field><field name="res_model">knr.shipping.config</field><field name="view_mode">tree,form</field></record>

 <record id="view_knr_delivery_report_form" model="ir.ui.view"><field name="name">knr.delivery.report.form</field><field name="model">knr.delivery.report</field><field name="arch" type="xml">
  <form><sheet><group><field name="service_date"/></group><group string="Jadwal Pengiriman"><field name="order_ids" readonly="1"><tree default_order="service_datetime asc"><field name="name"/><field name="client_id"/><field name="service_datetime"/><field name="delivery_address"/><field name="state"/></tree></field></group></sheet></form></field></record>
 <record id="action_knr_delivery_report" model="ir.actions.act_window"><field name="name">Jadwal Pengiriman per Tanggal</field><field name="res_model">knr.delivery.report</field><field name="view_mode">tree,form</field></record>
</odoo>
