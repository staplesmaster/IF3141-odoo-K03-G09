<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_knr_opportunity_tree" model="ir.ui.view"><field name="name">knr.opportunity.tree</field><field name="model">knr.opportunity</field><field name="arch" type="xml">
  <tree><field name="name"/><field name="client_id"/><field name="expected_value"/><field name="expected_datetime"/><field name="stage" widget="badge"/><field name="followup_date"/></tree></field></record>
 <record id="view_knr_opportunity_form" model="ir.ui.view"><field name="name">knr.opportunity.form</field><field name="model">knr.opportunity</field><field name="arch" type="xml">
  <form><header><button name="action_create_order" type="object" string="Buat Pesanan dari Peluang" class="btn-primary" groups="knr_order.group_knr_controller" invisible="stage != 'agreed' or order_id"/><field name="stage" widget="statusbar" statusbar_visible="new,offered,agreed,lost"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="client_id"/><field name="expected_value"/><field name="expected_datetime"/></group><group><field name="followup_date"/><field name="order_id"/></group></group><notebook><page string="Kebutuhan"><field name="need_description"/></page><page string="Interaksi dan Tindak Lanjut"><field name="interaction_notes"/><field name="followup_plan"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
 <record id="action_knr_opportunity" model="ir.actions.act_window"><field name="name">CRM &amp; Peluang</field><field name="res_model">knr.opportunity</field><field name="view_mode">tree,form</field></record>
</odoo>
