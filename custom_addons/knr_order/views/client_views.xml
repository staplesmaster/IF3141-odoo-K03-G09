<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_knr_client_tree" model="ir.ui.view"><field name="name">knr.client.tree</field><field name="model">knr.client</field><field name="arch" type="xml">
  <tree><field name="name"/><field name="contact_name"/><field name="phone"/><field name="partnership"/><field name="active"/></tree></field></record>
 <record id="view_knr_client_form" model="ir.ui.view"><field name="name">knr.client.form</field><field name="model">knr.client</field><field name="arch" type="xml">
  <form><sheet><div class="oe_button_box" name="button_box"><button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-bag"><field name="order_count" widget="statinfo" string="Pesanan"/></button></div><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="contact_name"/><field name="phone"/><field name="email"/></group><group><field name="partnership"/><field name="active"/></group></group><group><field name="address"/></group><notebook><page string="Riwayat Pesanan"><field name="order_ids" readonly="1"><tree><field name="name"/><field name="service_datetime"/><field name="total"/><field name="state" widget="badge"/></tree></field></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div></form></field></record>
 <record id="view_knr_client_search" model="ir.ui.view"><field name="name">knr.client.search</field><field name="model">knr.client</field><field name="arch" type="xml">
  <search><field name="name"/><field name="phone"/><filter name="active" string="Aktif" domain="[('active','=',True)]"/><filter name="partner" string="Mitra" domain="[('partnership','=','partner')]"/></search></field></record>
 <record id="action_knr_client" model="ir.actions.act_window"><field name="name">Klien Institusi</field><field name="res_model">knr.client</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_knr_client_search"/></record>
</odoo>
